# Copy to .env and fill in values.
# This is the single source of truth for all runtime configuration.
# Tuning knobs (pool sizes, cache TTLs, cron schedules, batch sizes, gRPC timeouts, etc.)
# have sensible defaults in each service's config.py — add them here only when overriding.

# ==================== Environment ====================
ENV=development
DEBUG=true
LOG_LEVEL=INFO

# ==================== Database ====================
DB_HOST=postgres
DB_NAME=minsik_db
DB_USER=postgres
DB_PASSWORD=postgres

# ==================== Redis ====================
REDIS_HOST=redis
REDIS_PASSWORD=password

# ==================== Gateway ====================
GATEWAY_HTTP_PORT=8040

# Allowed browser origins (comma-separated). Only used in development;
# nginx handles CORS in production.
CORS_ORIGINS=http://localhost:3000

# Cookies: dev (http localhost) -> COOKIE_SECURE=false, empty domain.
# Prod (https, shared subdomains) -> COOKIE_SECURE=true, COOKIE_DOMAIN=.yourdomain.tld
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# ==================== Authentication ====================
# REQUIRED: long random string (at least 32 characters), e.g. `openssl rand -hex 32`
JWT_SECRET_KEY=change-me-generate-a-long-random-secret

# Google OAuth - create credentials at https://console.cloud.google.com
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# ==================== External APIs ====================
GOOGLE_BOOKS_API_KEY=your-google-books-api-key

# ==================== Observability ====================
LEDGER_API_KEY=

# Comma-separated IPs allowed to set X-Forwarded-For (your reverse proxy).
# Dev default (127.0.0.1) matches the local setup below; in prod this
# must be the actual proxy IP, never "*" (spoofable rate-limit bypass).
TRUSTED_PROXY_IPS=127.0.0.1

# ==================== Content ====================
# Languages with dedicated recommendation pools (comma-separated ISO codes)
AVAILABLE_LANGUAGES=en,pl,de,es,fr

# ==================== Frontend (production only) ====================
FRONTEND_PORT=3000
NUXT_PUBLIC_API_BASE=https://your-api-domain
NUXT_PUBLIC_SITE_URL=https://your-site-domain
NUXT_PUBLIC_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
