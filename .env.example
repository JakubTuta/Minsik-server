# ==================== Environment ====================
ENV=development
DEBUG=true
LOG_LEVEL=INFO

# ==================== PostgreSQL Database ====================
# Single database with multiple schemas (auth, books, user_data, recommendations)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=minsik_db
DB_USER=postgres
DB_PASSWORD=postgres

# Connection pooling
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# ==================== Redis ====================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=password
REDIS_MAX_CONNECTIONS=20

# ==================== Gateway Service ====================
GATEWAY_HTTP_PORT=8040
GATEWAY_HOST=0.0.0.0
GATEWAY_WORKERS=4

# CORS (only enabled in development, nginx handles it in production)
CORS_ORIGINS=http://localhost:3000
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
CORS_ALLOW_HEADERS=*

# gRPC Connection Pool
GRPC_KEEPALIVE_TIME_MS=300000
GRPC_KEEPALIVE_TIMEOUT_MS=10000
GRPC_TIMEOUT=10.0
GRPC_RECOMMENDATION_TIMEOUT=30.0
GRPC_ADMIN_TIMEOUT=60.0
RECOMMENDATION_RECOMPUTE_ON_USER_WRITE=true

# ==================== Auth Service ====================
AUTH_SERVICE_HOST=auth-service
AUTH_SERVICE_PORT=50051
AUTH_GRPC_PORT=50051

# ==================== Books Service ====================
BOOKS_SERVICE_HOST=books-service
BOOKS_SERVICE_PORT=50055
BOOKS_GRPC_PORT=50055

# Cache TTLs (seconds)
CACHE_BOOK_DETAIL_TTL=3600
CACHE_AUTHOR_DETAIL_TTL=3600
CACHE_AUTHOR_BOOKS_TTL=1800
CACHE_SEARCH_TTL=900
CACHE_POPULAR_TTL=21600
CACHE_CATEGORY_TOP_BOOKS_TTL=93600
CATEGORY_CACHE_REFRESH_INTERVAL_HOURS=24

# View count tracking
VIEW_COUNT_FLUSH_INTERVAL=300
VIEW_COUNT_FLUSH_BATCH_SIZE=100

# Search configuration
SEARCH_DEFAULT_LIMIT=10
SEARCH_MAX_LIMIT=100
SEARCH_AUTHOR_BOOKS_EXPANSION=3

# ==================== Elasticsearch ====================
ES_HOST=elasticsearch
ES_PORT=9200
ES_INDEX_BOOKS=books
ES_INDEX_AUTHORS=authors
ES_INDEX_SERIES=series
ES_REINDEX_INTERVAL_HOURS=6
ES_REINDEX_BATCH_SIZE=1000

# ==================== Ingestion Service ====================
INGESTION_SERVICE_HOST=ingestion-service
INGESTION_SERVICE_PORT=50054
INGESTION_GRPC_PORT=50054
INGESTION_BATCH_SIZE=50
INGESTION_MAX_RETRIES=3
INGESTION_RETRY_DELAY=5

# ==================== User Data Service ====================
USER_DATA_SERVICE_HOST=user-data-service
USER_DATA_SERVICE_PORT=50053
USER_DATA_GRPC_PORT=50053

# ==================== Recommendation Service ====================
RECOMMENDATION_SERVICE_HOST=recommendation-service
RECOMMENDATION_SERVICE_PORT=50056
RECOMMENDATION_GRPC_PORT=50056

# List generation
LIST_DEFAULT_SIZE=50
CACHE_RECOMMENDATION_TTL=86400
CACHE_CONTEXTUAL_TTL=21600
CACHE_PROFILE_TTL=86400
CACHE_PERSONAL_TTL=86400
CACHE_PERSONAL_CONTEXTUAL_TTL=1800
PERSONAL_COLD_START_THRESHOLD=5
CONTEXTUAL_PRECOMPUTE_MIN_RATINGS=500
CONTEXTUAL_COLD_TTL=1800

# Home page category configuration (comma-separated category keys)
HOME_BOOK_CATEGORIES=most_read,highest_rated,trending_reads,most_wanted,recently_added,user_favorites,classics,best_writing,funniest,most_emotional
HOME_AUTHOR_CATEGORIES=top_authors,popular_authors

# Case opening pool configuration
CASE_POOL_REFRESH_HOURS=1
CACHE_CASE_POOL_TTL=7200

# ==================== Analytics Service ====================
ANALYTICS_SERVICE_HOST=analytics-service
ANALYTICS_SERVICE_PORT=50058
ANALYTICS_GRPC_PORT=50058

# ==================== External APIs ====================
# Open Library (primary data source)
OPEN_LIBRARY_API_URL=https://openlibrary.org
OPEN_LIBRARY_RATE_LIMIT=100

# Google Books (supplementary data source)
GOOGLE_BOOKS_API_URL=https://www.googleapis.com/books/v1
GOOGLE_BOOKS_API_KEY=


# ==================== JWT Authentication ====================
# IMPORTANT: Change JWT_SECRET_KEY in production to a long random string (at least 32 characters)
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
BCRYPT_ROUNDS=12
MAX_FAILED_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=30

# ==================== Google OAuth ====================
# Create credentials at https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret


# ==================== Timeouts ====================
REDIS_TIMEOUT=1.0
REQUEST_TIMEOUT=30.0


# ==================== Rate Limiting ====================
# General endpoints (health, public APIs)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=10

# Admin endpoints (lower limits for sensitive operations)
RATE_LIMIT_ADMIN_PER_MINUTE=20

# Suggest/typeahead endpoint (higher limit — hit on every keystroke)
RATE_LIMIT_SUGGEST_PER_MINUTE=120

# ==================== Continuous Ingestion ====================
CONTINUOUS_FETCH_ENABLED=true
CONTINUOUS_OL_CRON=0 * * * *
CONTINUOUS_OL_BOOKS_PER_RUN=100
CONTINUOUS_GB_CRON=0 */6 * * *
CONTINUOUS_GB_BOOKS_PER_RUN=40

# ==================== Description Enrichment ====================
DESCRIPTION_ENRICH_ENABLED=true
DESCRIPTION_ENRICH_CRON=30 */2 * * *
DESCRIPTION_ENRICH_BATCH_SIZE=5
DESCRIPTION_MIN_LENGTH=300

# ==================== Open Library Data Dump Import ====================
OL_DUMP_BASE_URL=https://openlibrary.org/data
DUMP_BATCH_SIZE=500
DUMP_TMP_DIR=/tmp
DUMP_COMMIT_INTERVAL=5000
DUMP_EDITION_BATCH_SIZE=2000
DUMP_EDITIONS_ENABLED=true
DUMP_RATINGS_ENABLED=true
DUMP_READING_LOG_ENABLED=true
DUMP_WIKIDATA_ENABLED=true
DUMP_EDITION_FLUSH_INTERVAL=100000
DUMP_WORK_MIN_QUALITY_SCORE=2
DUMP_AUTHOR_MIN_QUALITY_SCORE=2

# ==================== Data Cleanup ====================
CLEANUP_ENABLED=true
CLEANUP_CRON=0 3,15 * * *
CLEANUP_BOOK_MIN_QUALITY_SCORE=4
CLEANUP_AUTHOR_MIN_BOOKS=2
CLEANUP_BOOK_BATCH_SIZE=100
CLEANUP_AUTHOR_BATCH_SIZE=50
CLEANUP_SERIES_BATCH_SIZE=500
CLEANUP_GENRE_BATCH_SIZE=1000
CLEANUP_AUTHOR_MAX_BOOKS=500
CLEANUP_SERIES_MIN_BOOKS=3
CLEANUP_SERIES_MAX_BOOKS=30

# ==================== Service-Specific Connection Pooling ====================
# Production overrides for resource-constrained environments
# (Leave as-is for development, adjust for production)
INGESTION_DB_POOL_SIZE=3
INGESTION_DB_MAX_OVERFLOW=5
INGESTION_REDIS_MAX_CONNECTIONS=10

BOOKS_DB_POOL_SIZE=3
BOOKS_DB_MAX_OVERFLOW=5
BOOKS_REDIS_MAX_CONNECTIONS=10

RECOMMENDATION_DB_POOL_SIZE=10
RECOMMENDATION_DB_MAX_OVERFLOW=20

AUTH_DB_POOL_SIZE=3
AUTH_DB_MAX_OVERFLOW=5

USER_DATA_DB_POOL_SIZE=3
USER_DATA_DB_MAX_OVERFLOW=5
USER_DATA_REDIS_MAX_CONNECTIONS=5

# ==================== Ledger API Key ====================
LEDGER_API_KEY=