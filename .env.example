# Copy to .env and adjust. Tuning knobs (cache TTLs, cron schedules, batch sizes,
# gRPC timeouts, service hosts/ports) have sensible defaults baked into
# docker-compose.yml / docker-compose.prod.yml as ${VAR:-default} and the service
# configs - override them in .env only when needed.

# ==================== Environment ====================
DEBUG=true
LOG_LEVEL=INFO

# ==================== PostgreSQL ====================
DB_HOST=postgres
DB_PORT=5432
DB_NAME=minsik_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# ==================== Redis ====================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=password

# ==================== Gateway ====================
GATEWAY_HTTP_PORT=8040
GATEWAY_WORKERS=2

# Allowed browser origins (comma-separated). Only used in development;
# nginx handles CORS in production.
CORS_ORIGINS=http://localhost:3000

# ==================== Authentication ====================
# REQUIRED: long random string (at least 32 characters), e.g. `openssl rand -hex 32`
JWT_SECRET_KEY=change-me-generate-a-long-random-secret

# Cookies: dev (http localhost) -> COOKIE_SECURE=false, empty domain.
# Prod (https, shared subdomains) -> COOKIE_SECURE=true, COOKIE_DOMAIN=.yourdomain.tld
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# Google OAuth - create credentials at https://console.cloud.google.com
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# ==================== Rate Limiting ====================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_ADMIN_PER_MINUTE=20
RATE_LIMIT_SUGGEST_PER_MINUTE=120

# ==================== External APIs ====================
GOOGLE_BOOKS_API_KEY=your-google-books-api-key

# ==================== Content ====================
# Languages with dedicated recommendation pools (comma-separated ISO codes)
AVAILABLE_LANGUAGES=en

# Home page sections (comma-separated category keys)
HOME_BOOK_CATEGORIES=most_read,highest_rated,trending_reads,most_wanted,recently_added,user_favorites,classics,best_writing,funniest,most_emotional
HOME_AUTHOR_CATEGORIES=top_authors,popular_authors

# ==================== Observability ====================
LEDGER_API_KEY=

# ==================== Frontend (production only) ====================
FRONTEND_PORT=3000
NUXT_PUBLIC_API_BASE=https://your-api-domain/api/v1
NUXT_PUBLIC_SITE_URL=https://your-site-domain
NUXT_PUBLIC_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
